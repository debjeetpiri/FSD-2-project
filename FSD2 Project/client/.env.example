# ──────────────────────────────────────────────────────────────────────────────
# Client Environment Variables
# Copy this file to .env.local and fill in your values.
# In Vite, only variables prefixed with VITE_ are exposed to the browser.
# NEVER put secrets (API keys, DB credentials) here.
# ──────────────────────────────────────────────────────────────────────────────

# Backend API base URL
# During dev, leave this blank — Vite's proxy (vite.config.js) handles it.
# In production, point it to your deployed API (e.g. https://api.yourdomain.com/api)
VITE_API_URL=
